# ✅ Phase-2: session/database optional (আপনি চাইলে file রাখতেই পারেন)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ✅ IMPORTANT: Step-10 Listener ShouldQueue হলে এটা database হওয়া লাগবে
QUEUE_CONNECTION=sync

